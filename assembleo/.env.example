# Local development defaults. In Cloudflare Pages, set these under
# Settings -> Environment variables (and secrets with `wrangler pages secret put`).

PUBLIC_SITE_URL=https://assembleo.ca

# The API runs as Pages Functions on the SAME origin (/api/...), so this is
# intentionally unset. Only set it if the API is ever split onto its own host.
# PUBLIC_API_BASE=

# true  -> run the frontend with no backend at all (src/lib/mock.ts)
# false -> talk to the real Pages Functions (`npx wrangler pages dev dist`)
PUBLIC_API_MOCK=true

# Flip to true once GOOGLE_PLACE_ID and GOOGLE_MAPS_KEY are set on the server:
PUBLIC_REVIEWS_LIVE=false

# Turnstile site key (public half). Leave blank in dev; the widget is skipped.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token: free, cookieless, needs no consent banner.
PUBLIC_CF_ANALYTICS_TOKEN=

# Optional. Google Tag Manager container; omitted entirely when blank.
PUBLIC_GTM_ID=
