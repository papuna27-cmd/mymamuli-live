# Local development defaults. Copy to .env.production with real values to deploy.
PUBLIC_SITE_URL=https://assembleo.ca
PUBLIC_API_BASE=https://api.assembleo.ca
# Run the whole frontend without the Worker:
PUBLIC_API_MOCK=true
# Flip to true once the Worker's /api/reviews is deployed:
PUBLIC_REVIEWS_LIVE=false
# Leave blank to fall back to the manual distance input:
PUBLIC_GOOGLE_MAPS_KEY=
# Leave blank in development; Turnstile is skipped:
PUBLIC_TURNSTILE_SITE_KEY=
# Leave blank to omit GTM entirely:
PUBLIC_GTM_ID=
