---
/**
 * Sticky bottom action bar — phone only, hidden at 768px and up by CSS.
 * This is the primary conversion path on mobile.
 *
 * Two rules it enforces:
 *  1. It never offers the page you are already on.
 *  2. It hides itself whenever another amber control is on screen, so there is
 *     only ever one filled --signal target in the viewport (DESIGN.md §3.3).
 */
import { site, telHref } from '../data/site';

interface Props { path: string; }
const { path } = Astro.props;

// On /contact the form is already on the page, so a "get a quote" button
// would point at itself. Calling is the useful alternative there.
const callOnly = path === '/contact';
const primary =
  path === '/calculator'
    ? { label: 'Book a job', href: '/contact' }
    : { label: 'Get a quote', href: '/calculator' };
---

<div class:list={['actionbar', callOnly && 'actionbar--single']} role="group" aria-label="Quick actions">
  {!callOnly && <a class="btn btn--signal" href={primary.href}>{primary.label}</a>}
  <a class:list={['btn', callOnly ? 'btn--signal' : 'btn--ghost', 'actionbar__call']} href={telHref}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
    </svg>
    <span>Call{callOnly && <> {site.phoneDisplay}</>}{!callOnly && <span class="visually-hidden"> {site.phoneDisplay}</span>}</span>
  </a>
</div>

<script is:inline>
  // One amber target per screen. ~500 bytes, no framework.
  (function () {
    var bar = document.querySelector('.actionbar');
    if (!bar || !('IntersectionObserver' in window)) return;

    var seen = [];
    function refresh() {
      var any = false;
      for (var i = 0; i < seen.length; i++) if (seen[i].inView) { any = true; break; }
      bar.classList.toggle('is-yielding', any);
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          for (var i = 0; i < seen.length; i++) {
            if (seen[i].el === e.target) { seen[i].inView = e.isIntersecting; return; }
          }
        });
        refresh();
      },
      // Discount the strip the bar itself occupies.
      { rootMargin: '-8px 0px -80px 0px' }
    );

    function scan() {
      var nodes = document.querySelectorAll('main .btn--signal:not([data-ab]):not(.calc__sticky .btn--signal)');
      for (var i = 0; i < nodes.length; i++) {
        nodes[i].setAttribute('data-ab', '1');
        seen.push({ el: nodes[i], inView: false });
        io.observe(nodes[i]);
      }
    }

    scan();
    // Islands render their amber controls after hydration.
    var queued = false;
    new MutationObserver(function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; scan(); });
    }).observe(document.body, { childList: true, subtree: true });
  })();
</script>
