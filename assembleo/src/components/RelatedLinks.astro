---
/**
 * Internal linking block. Every service page links to the calculator, the
 * commercial page and at least two sibling services — this component is what
 * guarantees it rather than leaving it to each page's copy.
 */
import { services } from '../data/services';
interface Props { current: string; }
const { current } = Astro.props;

const siblings = services.filter((s) => s.slug !== current && s.slug !== 'commercial');
const commercial = services.find((s) => s.slug === 'commercial')!;

const links = [
  ...siblings.map((s) => ({ href: s.href, label: s.name, sub: s.short })),
  ...(current === 'commercial' ? [] : [{ href: commercial.href, label: commercial.name, sub: commercial.short }]),
  { href: '/calculator', label: 'Price calculator', sub: 'Delivery and moving, priced on distance' },
];
---

<section class="section section--tight section--paper" aria-labelledby="related-h">
  <div class="wrap">
    <h2 id="related-h">Keep looking</h2>
    <ul class="rule-list rule-list--split" style="margin-top: var(--s-5)">
      {links.map((l) => (
        <li>
          <a class="rule-row" href={l.href}>
            <span>
              <span class="rule-row__title">{l.label}</span>
              <span class="rule-row__sub">{l.sub}</span>
            </span>
            <svg class="rule-row__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
