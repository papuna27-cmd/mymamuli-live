---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHero from '../components/PhotoHero.astro';
import FaqBlock from '../components/FaqBlock.astro';
import BookingForm from '../islands/BookingForm';
import { Picture } from 'astro:assets';

import { commercialServices } from '../data/service-pages';
import { alsoServe, trustPoints } from '../data/assembly';
import { gtaCities } from '../data/cities';
import { faqs } from '../data/faqs';
import { faqPage } from '../lib/schema';

import officeImg from '../assets/photos/seg-office.jpg';
import gymImg from '../assets/photos/seg-gym.jpg';
import clinicImg from '../assets/photos/seg-clinic.jpg';
import hotelImg from '../assets/photos/seg-hotel.jpg';

const PHOTOS: Record<string, ImageMetadata> = { office: officeImg, gym: gymImg, clinic: clinicImg, hotel: hotelImg };

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Commercial', href: '/commercial' },
];
---

<BaseLayout
  title="Commercial Furniture Assembly | GTA | Assembleo"
  description="Volume furniture assembly for GTA gyms, clinics, hotels and offices. Out-of-hours scheduling, $2M liability, WSIB, and net 30 invoicing."
  path="/commercial"
  crumbs={crumbs}
  schemas={[faqPage(faqs.commercial!)]}
>
  <PhotoHero
    image={officeImg}
    alt="A commercial office floor fitted out with assembled desks and chairs"
    eyebrow="Commercial · Ontario"
    h1="Commercial furniture assembly"
    lede="Gyms, clinics, hotels and offices. One contact, a fixed project price, and a crew that works around your hours instead of yours around ours."
    ctaLabel="Request a quote"
    ctaHref="#book"
  />

  <section class="section section--surface" aria-labelledby="seg-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="seg-h">Pick your kind of site</h2>
        <p class="lede section-intro">Each one is scheduled and priced differently, so each has its own page.</p>
      </div>
      <div class="segs">
        {commercialServices.map((s) => (
          <article class="seg">
            <a href={`/services/${s.slug}`} class="seg__link">
              <Picture
                src={PHOTOS[s.image]!}
                alt={s.imageAlt}
                widths={[380, 560, 760]}
                sizes="(min-width: 1024px) 24vw, (min-width: 640px) 46vw, 92vw"
                formats={['avif', 'webp']} fallbackFormat="jpg" quality={55}
                loading="lazy" class="seg__img"
              />
              <h3 class="seg__title">{s.name}</h3>
            </a>
            <p class="seg__blurb">{s.lede}</p>
          </article>
        ))}
      </div>

      <div class="alsoWrap">
        <p class="alsoWrap__h">We also fit out</p>
        <ul class="also">{alsoServe.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head"><h2 id="why-h">What you get that residential does not</h2></div>
      <dl class="kv">
        <div><dt>Scheduling</dt><dd>Evenings, overnight and weekends, so the floor stays open during business hours.</dd></div>
        <div><dt>Pricing</dt><dd>A fixed project price on unit count and site conditions — not an hourly rate that grows.</dd></div>
        <div><dt>Invoicing</dt><dd>Net 30 on an approved account, one invoice per project or per phase.</dd></div>
        <div><dt>Compliance</dt><dd>$2M commercial general liability and WSIB clearance, sent before the first visit.</dd></div>
        <div><dt>Contact</dt><dd>One person who knows your job, from the quote to the completion list.</dd></div>
        <div><dt>Handover</dt><dd>A completion record with photos, per room or per unit.</dd></div>
      </dl>
      <ul class="why">
        {trustPoints.map((t) => (
          <li class="why__item">
            <h3 class="why__title">{t.title}</h3>
            <p class="why__body">{t.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--surface" id="book" aria-labelledby="quote-h">
    <div class="wrap cols-2">
      <div>
        <div class="section-head">
          <h2 id="quote-h">Request a quote</h2>
          <p class="lede section-intro">
            Tell us the site and roughly how many units. We come back with a fixed price and the
            dates we can hold.
          </p>
        </div>
        <p class="small">
          We cover {gtaCities.slice(0, 8).map((c) => c.name).join(', ')} and the rest of the GTA —
          <a class="textlink" href="/service-areas">see every area</a>.
        </p>
      </div>
      <div class="panel">
        <BookingForm client:visible variant="commercial" heading="Tell us about the site" headingLevel="h3" />
      </div>
    </div>
  </section>

  <FaqBlock items={faqs.commercial!} heading="Commercial questions" id="faq" />
</BaseLayout>

<style>
  .seg__link { text-decoration: none; color: inherit; display: block; }
  .seg__link:hover .seg__title { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .why { margin-top: var(--s-10); }
</style>
