---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Steps from '../components/Steps.astro';
import RetailerWall from '../components/RetailerWall.astro';
import FaqBlock from '../components/FaqBlock.astro';
import Estimator from '../islands/Estimator';
import BookingForm from '../islands/BookingForm';
import Reviews from '../islands/Reviews';

import { site, telHref } from '../data/site';
import { alsoServe, extras, included, retailerNote, steps, trustPoints } from '../data/assembly';
import { commercialServices } from '../data/service-pages';
import { gtaCities } from '../data/cities';
import { getReviews } from '../lib/api';
import { faqs } from '../data/faqs';
import { faqPage } from '../lib/schema';

import heroImg from '../assets/photos/hero-room.jpg';
import homeImg from '../assets/photos/home-bedroom.jpg';
import segGym from '../assets/photos/seg-gym.jpg';
import segClinic from '../assets/photos/seg-clinic.jpg';
import segHotel from '../assets/photos/seg-hotel.jpg';
import segOffice from '../assets/photos/seg-office.jpg';

const segImages: Record<string, ImageMetadata> = {
  gym: segGym, clinic: segClinic, hotel: segHotel, office: segOffice,
};

const reviews = await getReviews();
const years = site.facts.yearsActive;

const title = 'Furniture Assembly Ontario | Home & Commercial | Assembleo';
const description =
  `Furniture assembly across Ontario for homes, gyms, clinics, hotels and offices. ${years} years, insured and WSIB-covered crews. Price your job in 30 seconds.`;
---

<BaseLayout title={title} description={description} path="/" schemas={[faqPage(faqs.general!)]}>
  <!-- ============================================================ hero -->
  {/* Split, not text-over-photo. The scrim version needed the picture dimmed
      to keep the copy at AA, which left a murky photo and grey type. Solid
      navy for the words, the photo at full contrast beside them. */}
  <section class="lede-hero">
    <div class="lede-hero__text">
      <div class="lede-hero__col">
        <p class="lede-hero__eyebrow">Ontario · {years} years · Insured</p>
        <h1 class="hero-title">Furniture assembly, done properly.</h1>
        <p class="lede-hero__support">
          Homes, gyms, clinics, hotels and offices. Flat prices, insured crews, and the cardboard
          leaves with us.
        </p>
        <div class="lede-hero__actions">
          <a class="btn btn--signal" href="#estimate">Price my job</a>
          <a class="btn btn--onink" href={telHref}>Call {site.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <div class="lede-hero__media">
      <Picture
        src={heroImg}
        alt="A finished bedroom with an assembled wardrobe, bed frame and bedside units"
        widths={[640, 960, 1400, 2000]}
        sizes="(min-width: 900px) 52vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={62}
        loading="eager"
        fetchpriority="high"
        class="lede-hero__img"
      />
    </div>
  </section>

  <!-- ====================================================== proof strip -->
  <section class="proof" aria-label="What we bring to every job">
    <div class="wrap proof__grid">
      <div class="proof__item"><span class="proof__n">{site.facts.jobsCompleted}</span><span class="proof__l">jobs completed</span></div>
      <div class="proof__item"><span class="proof__n">{site.facts.rating} ★</span><span class="proof__l">{site.facts.reviewCount} reviews</span></div>
      <div class="proof__item"><span class="proof__n">{site.facts.liabilityCover}</span><span class="proof__l">liability insured</span></div>
      <div class="proof__item"><span class="proof__n">WSIB</span><span class="proof__l">covered crews</span></div>
    </div>
  </section>

  <!-- ======================================================= retailers -->
  <section class="retail" aria-labelledby="retail-h">
    <div class="wrap">
      <h2 id="retail-h" class="retail__h">Bought it anywhere? We build it.</h2>
      <RetailerWall />
      <p class="legal retail__note">{retailerNote}</p>
    </div>
  </section>

  <!-- ======================================================== two paths -->
  <section class="section section--paper" id="what" aria-labelledby="what-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="what-h">Two kinds of job</h2>
        </div>
        <p class="lede">
          Same crew, same standard. The difference is how it is priced and when we turn up.
        </p>
      </div>

      <div class="paths">
        <article class="path">
          <Picture
            src={homeImg}
            alt="A finished bedroom with an assembled nightstand, armchair and bed"
            widths={[420, 640, 900]}
            sizes="(min-width: 768px) 46vw, 92vw"
            formats={['avif', 'webp']} fallbackFormat="jpg" quality={58}
            loading="lazy" class="path__img"
          />
          <div class="path__body">
            <h3 class="path__title">Homes</h3>
            <p>
              Flat-pack from any retailer: wardrobes, beds, desks, dressers, patio sets and home
              gyms. Priced per item, so you know the number before we arrive.
            </p>
            <a class="textlink" href="/services/home-furniture">Home furniture assembly</a>
          </div>
        </article>

        <article class="path">
          <Picture
            src={segOffice}
            alt="An open-plan office fitted out with rows of assembled desks and chairs"
            widths={[420, 640, 900]}
            sizes="(min-width: 768px) 46vw, 92vw"
            formats={['avif', 'webp']} fallbackFormat="jpg" quality={58}
            loading="lazy" class="path__img"
          />
          <div class="path__body">
            <h3 class="path__title">Commercial</h3>
            <p>
              Gyms, clinics, hotels, offices and warehouses. Quoted individually on unit count and
              site conditions, scheduled around your hours, invoiced on terms.
            </p>
            <a class="textlink" href="/commercial">See commercial work</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ====================================================== commercial -->
  <section class="section section--surface" id="commercial" aria-labelledby="com-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Commercial</p>
          <h2 id="com-h">Sites that cannot close</h2>
        </div>
        <p class="lede">
          Volume work for sites that cannot close. One contact, a fixed project price, and a crew
          that works evenings, weekends or overnight.
        </p>
      </div>

      <div class="segs">
        {commercialServices.map((s) => (
          <article class="seg">
            <a class="seg__link" href={`/services/${s.slug}`}>
              <Picture
                src={segImages[s.image]!}
                alt={s.imageAlt}
                widths={[380, 560, 760]}
                sizes="(min-width: 1024px) 24vw, (min-width: 640px) 46vw, 92vw"
                formats={['avif', 'webp']} fallbackFormat="jpg" quality={55}
                loading="lazy" class="seg__img"
              />
              <h3 class="seg__title">{s.name}</h3>
            </a>
            <p class="seg__blurb">{s.lede}</p>
          </article>
        ))}
      </div>

      <div class="alsoWrap">
        <p class="alsoWrap__h">We also fit out</p>
        <ul class="also">{alsoServe.map((a) => <li>{a}</li>)}</ul>
      </div>

      <div class="comCta">
        <p class="comCta__text">
          Commercial jobs are not priced by the item. Send a furniture list, a PO or a floor plan and
          you get a fixed project price and the dates we can hold.
        </p>
        <a class="btn btn--ink btn--block" href="/commercial">See commercial work</a>
      </div>
    </div>
  </section>

  <!-- =========================================================== steps -->
  <section class="section section--ink" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Four steps</p>
        <h2 id="how-h">How it works</h2>
      </div>
      <Steps items={steps} />
    </div>
  </section>

  <!-- ======================================================= estimator -->
  <section class="section section--surface" id="estimate" aria-labelledby="est-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Pricing</p>
          <h2 id="est-h">What will it cost?</h2>
        </div>
        <p class="lede">
          Pick what you need built. You get a real range in about thirty seconds, with no contact
          details asked for.
        </p>
      </div>
      <Estimator client:visible />
    </div>
  </section>

  <!-- =========================================================== scope -->
  <section class="section section--paper" aria-labelledby="scope-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">No surprises</p>
        <h2 id="scope-h">What the price covers</h2>
      </div>
      <div class="scopeGrid">
        <div>
          <h3 class="scopeGrid__h">Included in every job</h3>
          <ul class="ticks">{included.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h3 class="scopeGrid__h">Costs extra — ask when you book</h3>
          <ul class="ticks ticks--extra">{extras.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= why -->
  <section class="section section--paper" id="why" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why us</p>
        <h2 id="why-h">Why people book us twice</h2>
      </div>
      <ul class="why">
        {trustPoints.map((t) => (
          <li class="why__item">
            <h3 class="why__title">{t.title}</h3>
            <p class="why__body">{t.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ========================================================= reviews -->
  <section class="section section--surface" aria-labelledby="rev-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{site.facts.reviewCount} reviews</p>
        <h2 id="rev-h">What customers say</h2>
      </div>
      <Reviews
        client:visible
        reviews={reviews.reviews}
        rating={reviews.rating}
        count={reviews.count}
        profileUrl={reviews.profileUrl}
      />
    </div>
  </section>

  <!-- =================================================== service areas -->
  <section class="section section--surface" aria-labelledby="areas-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Service areas</p>
          <h2 id="areas-h">Where we work</h2>
        </div>
        <p class="lede">
          The whole Greater Toronto Area, from our Mississauga depot. Each area has its own page
          with drive times and what we mostly get called for there.
        </p>
      </div>
      <ul class="areaChips">
        {gtaCities.map((c) => (
          <li><a href={`/service-areas/${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
      <p class="small areaAll"><a class="textlink" href="/service-areas">Every area we cover</a></p>
    </div>
  </section>

  <!-- ============================================================= faq -->
  <FaqBlock items={faqs.general!} heading="Questions people ask" id="faq" />

  <!-- ============================================================ book -->
  <section class="section on-ink" id="book" aria-labelledby="book-h">
    <div class="wrap bookGrid">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="book-h">Get a fixed price</h2>
        <p class="lede bookGrid__lede">
          Send the list and you will have a price and a date back within two hours during working
          hours. Nothing is charged before the job is done.
        </p>
        <dl class="bookGrid__facts">
          <div><dt>Phone</dt><dd><a href={telHref}>{site.phoneDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Hours</dt><dd>{site.hours[0]!.display}, Mon–Fri</dd></div>
        </dl>
      </div>
      <div class="panel bookGrid__panel">
        <BookingForm client:visible variant="residential" heading="Tell us about the job" headingLevel="h3" />
      </div>
    </div>
  </section>
</BaseLayout>
